# ==============================================================================
# CMS Monorepo - Unified Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project & Server Environment
# ------------------------------------------------------------------------------
PROJECT_NAME=cms
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
HOSTNAME=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Service & Exposed Ports
# ------------------------------------------------------------------------------
API_PORT=3001
ADMIN_PORT=3002
CLIENT_PORT=3003

# Database & Storage Tools (Exposed for Compass, Redis Insight, MinIO Console)
MONGO_PORT=27017
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# 3. Inter-Service Network URLs
# ------------------------------------------------------------------------------
API_URL=http://api:3001
SITE_URL=http://localhost:3003
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3003

# ------------------------------------------------------------------------------
# 4. Databases & Infrastructure (Internal Docker Network)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=cms_dev
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 5. Media Storage (MinIO / S3)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=cms-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/cms-media
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 6. Auth, Security & Rate Limiting
# ------------------------------------------------------------------------------
SETUP_ENABLED=true
JWT_SECRET=cms-dev-jwt-secret-min-32-chars-long-please-change-in-prod
VAULT_SECRET=cms-dev-vault-secret-min-32-chars-long-please-change
BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
SESSION_TTL_HOURS=24
SESSION_SLIDE_THRESHOLD_MINUTES=15

RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_TIME_WINDOW="1 minute"
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_TIME_WINDOW="1 minute"
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_TIME_WINDOW="1 minute"

# ------------------------------------------------------------------------------
# 7. Forms & Anti-Bot Captcha
# ------------------------------------------------------------------------------
CAPTCHA_SECRET=cms-dev-captcha-secret-change-in-prod
CAPTCHA_MAX_AGE_SECONDS=600

# ------------------------------------------------------------------------------
# 8. Docker Build Targets & Image Overrides (Parametric Compose)
# ------------------------------------------------------------------------------
# API_DOCKERFILE=api/Dockerfile.dev                 # Set to api/Dockerfile for production
# ADMIN_DOCKERFILE=admin/Dockerfile.dev             # Set to admin/Dockerfile for production
# CLIENT_DOCKERFILE=client-template/Dockerfile.dev  # Set to client-template/Dockerfile for production
# MONGO_IMAGE=mongo:8
# REDIS_IMAGE=redis:8

# ------------------------------------------------------------------------------
# 9. Package Registry & Publishing (Optional)
# ------------------------------------------------------------------------------
# NODE_AUTH_TOKEN=ghp_your_github_token_or_npm_automation_token_here


