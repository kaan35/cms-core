{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@cms/client-sdk": ["../packages/client-sdk/src/index.ts"],
      "@cms/plugin-pages-api": ["../plugins/plugin-pages/api/src/index.ts"],
      "@cms/plugin-blog-api": ["../plugins/plugin-blog/api/src/index.ts"],
      "@cms/plugin-forms-api": ["../plugins/plugin-forms/api/src/index.ts"],
      "@cms/plugin-media-api": ["../plugins/plugin-media/api/src/index.ts"],
      "@cms/plugin-system-api": ["../plugins/plugin-system/api/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
