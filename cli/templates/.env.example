# ==============================================================================
# CMS Project Environment Configuration
# ==============================================================================

# CMS Core Version Tag & Update Strategy
CMS_TAG=latest
AUTO_UPDATE=true

# Project Information
PROJECT_NAME=cms-project
NODE_ENV=production
LOG_LEVEL=info

# Cryptographic Keys (Auto-generated random >= 32 characters)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long

# Service Ports
API_PORT=3001
ADMIN_PORT=3002
CLIENT_PORT=3000

# Database & Cache
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=cms
REDIS_URL=redis://redis:6379

# Network & Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
API_URL=http://api:3001
HOST=0.0.0.0
