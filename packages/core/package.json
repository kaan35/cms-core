    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11",
    "@fastify/cors": "^11",
    "@fastify/helmet": "^13",
    "@fastify/rate-limit": "^11",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5",
    "redis": "^6",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^26"
  }
}
