{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=../.env --import tsx/esm --watch src/main.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=../.env --import tsx/esm src/main.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx/esm --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cms/core": "*",
    "@cms/db": "*",
    "@cms/plugin-auth-api": "*",
    "@cms/plugin-system-api": "*",
    "@cms/plugin-media-api": "*",
    "@cms/plugin-pages-api": "*",
    "@cms/plugin-blog-api": "*",
    "@cms/plugin-forms-api": "*",
    "@cms/plugin-vault-api": "*"
  },
  "devDependencies": {
    "@types/node": "^26"
  }
}
