# ------------------------------------------------------------------------------
# App & Server Configuration
# ------------------------------------------------------------------------------
PROJECT_NAME=cms
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Databases & Infrastructure Ports
# ------------------------------------------------------------------------------
MONGO_PORT=27017
REDIS_PORT=6379

MONGO_URI=mongodb://cms_user:CHANGE_ME@localhost:27017/cms?authSource=admin
MONGO_DB_NAME=cms

REDIS_URL=redis://:CHANGE_ME@localhost:6379

# ------------------------------------------------------------------------------
# Auth & Security
# ------------------------------------------------------------------------------
SETUP_ENABLED=true
JWT_SECRET=cms-dev-jwt-secret-min-32-chars-long-please-change-in-prod
BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
SESSION_TTL_HOURS=24
SESSION_SLIDE_THRESHOLD_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_TIME_WINDOW="1 minute"
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_TIME_WINDOW="1 minute"
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_TIME_WINDOW="1 minute"

# ------------------------------------------------------------------------------
# Media Storage (S3 / MinIO)
# ------------------------------------------------------------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cms-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=CHANGE_ME
# Public URL served to clients (e.g. http://localhost:9000/cms-media for local MinIO, or https://cdn.example.com)
S3_PUBLIC_URL=http://localhost:9000/cms-media
S3_FORCE_PATH_STYLE=true
